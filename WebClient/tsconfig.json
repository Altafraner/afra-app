{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"],
            "#build/ui": ["./node_modules/.nuxt-ui/ui"]
        },
        "verbatimModuleSyntax": false,
        "allowJs": true
    },
    "exclude": ["node_modules", "dist"],
    "include": [
        "env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "auto-imports.d.ts",
        "components.d.ts"
    ]
}
